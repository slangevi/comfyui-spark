{
  "description": "Minimal SD1.5 text-to-image",
  "tags": ["txt2img"],
  "params": {
    "prompt":     { "path": "6.inputs.text",      "type": "string", "required": true },
    "negative":   { "path": "7.inputs.text",      "type": "string", "default": "" },
    "checkpoint": { "path": "4.inputs.ckpt_name", "type": "model",  "folder": "checkpoints" },
    "seed":       { "path": "3.inputs.seed",      "type": "int",    "default": "random" },
    "steps":      { "path": "3.inputs.steps",     "type": "int",    "default": 8 },
    "width":      { "path": "5.inputs.width",     "type": "int",    "default": 512 },
    "height":     { "path": "5.inputs.height",    "type": "int",    "default": 512 }
  }
}
