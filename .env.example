# Copy to .env and adjust. .env is gitignored.

# Host directory bind-mounted at /data — models, outputs, custom nodes,
# the overlay venv. Expect this to grow to hundreds of GB.
COMFYUI_DATA_PATH=/home/scott/LLMs/comfyui

# Host port. Always published on 127.0.0.1 only: ComfyUI has no
# authentication, so anything that can reach it can read and write files
# and execute custom-node code.
COMFYUI_PORT=8188

# Appended to the ComfyUI command line.
#   --highvram                     keep models resident; 121 GB unified memory
#                                  makes eviction pointless
#   --use-pytorch-cross-attention  xformers has no aarch64/sm_121 wheels
# Add --disable-all-custom-nodes here to boot past a node that breaks startup.
#
# Quoted (unlike a bare shell VAR=value1 value2): scripts/verify-http.sh
# sources this file with `. ./.env` to honour a non-default COMFYUI_PORT,
# and an unquoted multi-word value there makes the shell try to run
# "--use-pytorch-cross-attention" as a command. Quoting is transparent to
# docker compose, which strips it when interpolating ${COMFYUI_ARGS}.
COMFYUI_ARGS="--highvram --use-pytorch-cross-attention"

# Container user. Keep these matching your host user so files written to
# COMFYUI_DATA_PATH stay editable without sudo. Check with `id -u; id -g`.
# BUILD ARGS, not runtime settings: changing them here does nothing to an
# already-built image until you run `make build` (compose never rebuilds on
# `up`). The user layer sits below the torch layer, so that rebuild is
# minutes, not a 3 GB re-download.
PUID=1000
PGID=1000

# Optional, for gated HuggingFace repos. Read by scripts/fetch-model.sh on the
# host AND injected into the container (docker-compose.yml), where Manager's
# model downloader and huggingface-hub pick it up from the environment.
#
# The container is where custom-node code runs, so treat this as a secret you
# have handed to every node you install: any of them can read it and send it
# anywhere. Use a read-only token with the narrowest scope that works, and
# rotate it if you install nodes you have not read. Leave it empty if you do
# not need gated repos — nothing else depends on it.
HF_TOKEN=

# Set to 1 to let ComfyUI start without a GPU. Only for debugging. This
# skips the entrypoint's GPU guards AND appends --cpu to ComfyUI's command
# line — without --cpu the pinned ComfyUI crashes at import on a GPU-less
# host, so the override handles both halves.
# COMFYUI_ALLOW_CPU=1

# docker/entrypoint.sh reads a MANAGER_REF env var to pick the
# ComfyUI-Manager commit it checks out on a first clone into a fresh
# /data — but that variable is deliberately NOT listed in
# docker-compose.yml's `environment:` block, so setting MANAGER_REF here
# has NO effect. This is intentional, not an oversight: Manager is a
# supply-chain pin, and moving it off the audited commit should require
# editing a tracked, reviewed file (entrypoint.sh's own MANAGER_REF
# default), not one line in this gitignored file that's easy to set
# "temporarily" and forget. MANAGER_REF is also only consulted when no
# checkout exists yet — against a populated /data it does nothing. To
# re-pin an existing deployment, deliberately and visibly:
#   make down
#   rm -rf "$COMFYUI_DATA_PATH/custom_nodes/ComfyUI-Manager"
#   docker compose run --rm -e COMFYUI_SKIP_LAUNCH=1 -e MANAGER_REF=<sha> comfyui
#   make up
# (COMFYUI_SKIP_LAUNCH makes the one-off container do the clone and exit
# instead of booting a second ComfyUI against the live /data.)
